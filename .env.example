# Copy to .env (`make .env`) and adjust. .env is git-ignored.
# The values below are throwaway credentials for local containers only.

# --- docker compose ---
POSTGRES_USER=control_plane
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=control_plane
POSTGRES_PORT=5432
RABBITMQ_USER=control_plane
RABBITMQ_PASSWORD=local-dev-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- control plane (cmd/api) ---
HTTP_ADDR=:8080
DATABASE_URL=postgres://control_plane:local-dev-only@localhost:5432/control_plane?sslmode=disable
RABBITMQ_URL=amqp://control_plane:local-dev-only@localhost:5672/
LOG_LEVEL=info
# HTTP_REQUEST_TIMEOUT=10s
# HTTP_SHUTDOWN_TIMEOUT=15s
# OUTBOX_POLL_INTERVAL=500ms
# OUTBOX_BATCH_SIZE=100
# OUTBOX_LEASE=30s
# OUTBOX_PUBLISH_TIMEOUT=5s
# OUTBOX_RETRY_MIN=500ms
# OUTBOX_RETRY_MAX=30s

# --- worker simulator (cmd/worker); CLI flags override these ---
WORKER_FAIL_RATE=0
WORKER_MIN_DELAY_MS=500
WORKER_MAX_DELAY_MS=2000
